[Unit]
Description=Reconcile hart custom domains into Traefik dynamic config + Cloudflare DNS
After=network-online.target hart.service
Wants=network-online.target

[Service]
Type=oneshot
# Adjust for your host: a user that owns the Traefik watched dir (DEST) and can read CF_ENV.
User=hart
# Host-specific settings (REQUIRED: BOX_IP; optional: BOX_IP6, ENTRYPOINT, CERT_RESOLVER, MANAGE_DNS,
# CF_ENV, DEST, SERVICE_URL, HART_URL, PROPAGATE_WAIT):
EnvironmentFile=-/etc/hart/domain-sync.env
ExecStart=/opt/hart/hart-domain-sync.sh
